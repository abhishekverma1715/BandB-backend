{
  "name": "bandb-backend",
  "version": "1.0.0",
  "description": "B&B Plastic Backend API with MongoDB, Express, JWT, and Mongoose",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs watch server.ts",
    "build": "node node_modules/typescript/bin/tsc",
    "postinstall": "node node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "seed": "node node_modules/tsx/dist/cli.mjs seeder.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.3.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
